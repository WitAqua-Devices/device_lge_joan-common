// Stubs for the com.lge.* APIs that LG adds by patching framework.jar itself.
// We cannot ship their framework.jar, so the classes the stock apps reach for
// live here instead and go on the boot classpath next to it. Same idea as
// hardware/oneplus/oneplus-fwk.
//
// Only what the apps actually call is implemented: the surface comes from
// diffing the classes their smali references against the boot classpath this
// builds, so anything in here is something a shipped app would have died on.
java_library {
    name: "com.lge",
    installable: true,

    srcs: [
        "src/**/*.java",
    ],
}
