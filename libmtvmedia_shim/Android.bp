// What libmtv_servicejp.lge.so needs from a media framework that has moved on:
// libmediaextractor's DataSourceBase and the MIME types LG added to
// libstagefright_foundation, both simply gone, plus android 9 shaped versions
// of AudioTrack, MemoryHeapBase and NuPlayerDriver, and bridges for the two
// interfaces the framework calls back into - AudioSink and DataSource - whose
// slots moved under the blob's own vtables. extract-files.py points the blob at
// the first three by renaming the symbols it looks up, and rewrites its
// libmediaextractor NEEDED entry to this.
cc_library_shared {
    name: "libmtvmedia_shim",
    srcs: [
        "audiotrack_shim.cpp",
        "datasource_shim.cpp",
        "memoryheap_shim.cpp",
        "mtvmedia_shim.cpp",
        "nuplayer_shim.cpp",
    ],
    shared_libs: [
        "libaudioclient",
        "libbinder",
        "libcutils",
        "libdatasource",
        "liblog",
        "libmedia",
        "libmediaplayerservice",
        "libutils",
    ],
    // AttributionSourceState, which replaced the uid/pid pair the old
    // constructor took.
    static_libs: [
        "framework-permission-aidl-cpp",
    ],
    header_libs: [
        // AudioTrack.h pulls in media/Modulo.h, which libaudioclient does not
        // re-export.
        "libmedia_headers",
        // NuPlayerDriver is not part of libmediaplayerservice's exported set.
        "libstagefright_nuplayer_headers",
    ],
    // Only the 32-bit blob uses this.
    compile_multilib: "32",
}
