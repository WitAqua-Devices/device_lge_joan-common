// What libmtv_servicejp.lge.so wants from the media framework and no longer
// finds there: libmediaextractor's DataSourceBase, the MIME types LG added to
// libstagefright_foundation, the android 9 AudioTrack constructor, and a
// MemoryHeapBase laid out the way it was in android 9. The libmediaextractor
// NEEDED entry is rewritten to point at this in extract-files.py.
cc_library_shared {
    name: "libmtvmedia_shim",
    srcs: [
        "audiotrack_shim.cpp",
        "memoryheap_shim.cpp",
        "mtvmedia_shim.cpp",
    ],
    shared_libs: [
        "libaudioclient",
        "libbinder",
        "libcutils",
        "liblog",
        "libutils",
    ],
    // AttributionSourceState, which replaced the uid/pid pair the old
    // constructor took.
    static_libs: [
        "framework-permission-aidl-cpp",
    ],
    // AudioTrack.h pulls in media/Modulo.h, which libaudioclient does not
    // re-export.
    header_libs: [
        "libmedia_headers",
    ],
    // Only the 32-bit blob uses this.
    compile_multilib: "32",
}
