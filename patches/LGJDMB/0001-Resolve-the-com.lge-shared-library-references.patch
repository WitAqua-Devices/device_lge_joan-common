diff --git a/res/values/lge_res_compat.xml b/res/values/lge_res_compat.xml
new file mode 100644
index 0000000..21727e4
--- /dev/null
+++ b/res/values/lge_res_compat.xml
@@ -0,0 +1,71 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     The stock apk resolves these out of com.lge, the shared resource library
+     that ships as framework/lge-res/lge-res.apk. Nothing links that library in
+     here, so every one of those references stays a TYPE_DYNAMIC_REFERENCE, and
+     the first layout that wants a dimension out of one dies inflating:
+
+       add_preset_area_list_item -> TextView
+       UnsupportedOperationException: Can't convert value at index 2 to
+       dimension: type=0x7
+
+     which is the very first screen an unconfigured install shows, because it
+     goes straight to the area picker. The values below were read back out of
+     the stock library, so the app renders the way it does on stock without the
+     library having to be there.
+
+     Two of the colours carry an lgeres_ prefix: the app already has colours of
+     its own by those names, with different values, and the references that go
+     to com.lge are not the ones that go to the app's own.
+-->
+<resources>
+    <!-- LG's type scale. -->
+    <dimen name="type_a01_dp">12.0dp</dimen>
+    <dimen name="type_a02_sp">12.0sp</dimen>
+    <dimen name="type_b01_dp">14.0dp</dimen>
+    <dimen name="type_b02_dp">14.0dp</dimen>
+    <dimen name="type_b02_sp">14.0sp</dimen>
+    <dimen name="type_d01_dp">16.0dp</dimen>
+    <dimen name="type_d03_dp">16.0dp</dimen>
+    <dimen name="type_d03_sp">16.0sp</dimen>
+    <dimen name="type_e01_dp">18.0dp</dimen>
+    <dimen name="type_e01_sp">18.0sp</dimen>
+    <dimen name="type_f02_sp">20.0sp</dimen>
+    <dimen name="type_g01_dp">24.0dp</dimen>
+    <dimen name="type_k01_dp">10.0dp</dimen>
+    <dimen name="type_ak02_sp">17.0sp</dimen>
+    <dimen name="type_ap01_sp">22.0sp</dimen>
+
+    <!--
+         action_bar_*_text_color are references in lge-res too; these are the
+         literals they land on there, which are not the AOSP colours that share
+         those names.
+    -->
+    <color name="action_bar_title_text_color">#ff262626</color>
+    <color name="action_bar_subtitle_text_color">#ff7f7f7f</color>
+    <color name="lgeres_list_separator_background_color">#fff5f5f5</color>
+    <color name="lgeres_list_divider_color">#ffe1e1e1</color>
+
+    <!--
+         Theme.LGE.White is an empty style over LG's own base theme, so what it
+         contributes is that base. DeviceDefault.Light.DarkActionBar is what the
+         framework already fell back to when the reference did not resolve, and
+         it is the closest AOSP has.
+    -->
+    <style name="Theme.LGE.White" parent="@android:style/Theme.DeviceDefault.Light.DarkActionBar" />
+
+    <!-- Theme.LGE.Default.Translucent sets exactly these three. -->
+    <style name="Theme.LGE.White.Translucent" parent="@style/Theme.LGE.White">
+        <item name="android:windowBackground">@android:color/transparent</item>
+        <item name="android:windowIsTranslucent">true</item>
+        <item name="android:windowContentOverlay">@null</item>
+    </style>
+
+    <!-- ...and its NoTitleBar child drops the title and the action bar. -->
+    <style name="Theme.LGE.White.Translucent.NoTitleBar" parent="@style/Theme.LGE.White.Translucent">
+        <item name="android:windowNoTitle">true</item>
+        <item name="android:windowActionBar">false</item>
+    </style>
+
+    <style name="Widget.Holo.Light.Spinner" parent="@android:style/Widget.Holo.Light.Spinner" />
+</resources>
