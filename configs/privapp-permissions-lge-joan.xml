<!--
  ~ com.lge.oneseg is a product priv-app sharing the system uid, so the
  ~ privileged permissions it asks for have to be allowlisted on the product
  ~ partition or PackageManagerService refuses to start and the device boot
  ~ loops. Taken from the stock privapp-permissions-lge-joan.xml, trimmed to
  ~ the one package we ship out of the 65 it lists.
  -->
<permissions>
    <privapp-permissions package="com.lge.oneseg">
        <permission name="android.permission.ACCESS_CHECKIN_PROPERTIES"/>
        <permission name="android.permission.CALL_PRIVILEGED"/>
        <permission name="android.permission.FORCE_STOP_PACKAGES"/>
        <permission name="android.permission.MANAGE_USERS"/>
        <permission name="android.permission.READ_LOGS"/>
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <permission name="android.permission.REAL_GET_TASKS"/>
        <permission name="android.permission.SET_ANIMATION_SCALE"/>
        <permission name="android.permission.SET_TIME_ZONE"/>
    </privapp-permissions>
</permissions>
